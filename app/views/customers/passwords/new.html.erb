<% content_for :title, "Reset Password | Quilla Alma" %>

<div class="auth-page">
  <section class="auth-card">
    <p class="eyebrow">Account recovery</p>
    <h1>Forgot your password?</h1>

    <p class="auth-card__intro">
      Enter your email address to request password reset instructions.
    </p>

    <%= form_for(
          resource,
          as: resource_name,
          url: password_path(resource_name),
          html: { method: :post }
        ) do |f| %>

      <%= render "customers/shared/error_messages",
                 resource: resource %>

      <div class="form-field">
        <%= f.label :email %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          required: true %>
      </div>

      <div class="form-actions">
        <%= f.submit "Send reset instructions" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "customers/shared/links" %>
    </div>
  </section>
</div>
